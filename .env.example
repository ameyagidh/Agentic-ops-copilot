# Copy to .env and adjust. Every setting has a working default — the app
# runs fully offline (fake LLM + mock backends) with NO env vars set at all.
# Never commit a real .env file or real credentials.

# --- LLM provider: fake | openai | bedrock ---
OPS_LLM_PROVIDER=fake
OPS_LLM_MODEL=gpt-4o-mini
OPS_LLM_TEMPERATURE=0

# Required only if OPS_LLM_PROVIDER=openai
OPS_OPENAI_API_KEY=

# Required only if OPS_LLM_PROVIDER=bedrock (uses standard AWS credential
# resolution; set these or use an attached IAM role / `aws configure`)
OPS_BEDROCK_REGION=us-east-1
OPS_AWS_ACCESS_KEY_ID=
OPS_AWS_SECRET_ACCESS_KEY=

# --- Backends: logs = mock | loki, metrics = mock | prometheus ---
OPS_LOGS_BACKEND=mock
OPS_METRICS_BACKEND=mock
OPS_LOKI_BASE_URL=http://localhost:3100
OPS_PROMETHEUS_BASE_URL=http://localhost:9090
OPS_BACKEND_TIMEOUT_SECONDS=10

# --- Retrieval ---
OPS_RETRIEVAL_ENABLED=true
# openai embeddings require the `retrieval` extra and an OpenAI key; leave
# as "none" to use the dependency-free in-memory runbook store.
OPS_EMBEDDINGS_PROVIDER=none
OPS_RUNBOOKS_DIR=runbooks
OPS_VECTOR_STORE_DIR=.chroma

# --- Persistence ---
OPS_CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# --- API ---
# Leave blank to disable auth (fine for local/dev use).
OPS_API_KEY=
OPS_CORS_ORIGINS=["*"]
OPS_RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
OPS_LOG_LEVEL=INFO
OPS_LANGCHAIN_TRACING_V2=false
OPS_LANGCHAIN_API_KEY=
